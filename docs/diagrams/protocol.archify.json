    { "id": "cand", "lane": "select", "col": 0, "type": "backend", "label": "Candidate variants", "sublabel": "presets · settings", "width": 136 },
    { "id": "drule", "lane": "select", "col": 1, "type": "security", "label": "Dataset rule", "sublabel": "more datasets up than down", "width": 136 },
    { "id": "prereg", "lane": "select", "col": 2, "type": "security", "label": "Pre-register", "sublabel": "rules + code SHA-256", "width": 136 },
