    { "id": "crule", "lane": "eval", "col": 5, "type": "security", "label": "Claim rule", "sublabel": "≥ +0.008 and CI > 0", "width": 136 },
    { "id": "stop", "lane": "out", "col": 1, "type": "external", "label": "Stop", "sublabel": "no variant passes", "width": 136 },
